<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %} {% if site.enable_snowflakes %}snowflakes-enabled{% endif %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Snowflakes Effect -->
    {% if site.enable_snowflakes %}
      <div class="snowflake-area">
        {% for i in (1..250) %}
          <div class="snowflake _{{ i }}">❄️</div>
        {% endfor %}
        {% for i in (1..50) %}
          <div class="snowflake _md _md-{{ i }}">❄️</div>
        {% endfor %}
        {% for i in (1..50) %}
          <div class="snowflake _lg _lg-{{ i }}">❄️</div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- JavaScripts -->
    {% include scripts.liquid %}

    <!-- Email reveal (custom) -->
    <script src="{{ '/assets/js/email-text-fill.js' | relative_url }}"></script>

    <!-- Copyright at bottom -->
    <div class="bottom-copyright">
      <div class="container">
        &copy; Copyright {{ site.time | date: '%Y' }}
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}. {{ site.footer_text }}
        {% if site.impressum_path %}
          <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
        {% endif %}
        {% if site.last_updated %}
          Last updated: {{ 'now' | date: '%B %d, %Y' }}.
        {% endif %}
      </div>
    </div>

    <!-- Page View Counter -->
    <div class="bottom-view-counter">
      <div class="container">
        <span style="white-space: nowrap;"> Views:&nbsp;<span id="busuanzi_value_page_pv">Loading</span> </span>
      </div>
    </div>
  </body>
</html>
